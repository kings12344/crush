{
  "expo": {
    "name": "CRUSH",
    "slug": "crush-mobile",
    "scheme": "crush",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crush.social"
    },
    "android": {
      "package": "com.crush.social",
      "adaptiveIcon": {
        "backgroundColor": "#FFF5FA"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF5FA"
        }
      ]
    ]
  }
}
